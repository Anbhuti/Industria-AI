        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "workspaceId", "title"]
    },
    "NovaMessage": {
      "title": "NovaMessage",
      "description": "User or AI response message in NOVA dialogue",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "conversationId", "role", "content"]
    },
    "SavedView": {
      "title": "SavedView",
      "description": "User custom filtered view of industrial fleet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "workspaceId", "userId", "name"]
    },
    "DashboardConfig": {
      "title": "DashboardConfig",
      "description": "User personalized KPI widgets and time ranges",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "defaultTimeRange": { "type": "string" },
        "defaultPlantId": { "type": "string" }
      },
      "required": ["id", "workspaceId", "userId"]
    },
    "AlertPreference": {
      "title": "AlertPreference",
      "description": "User telemetry alarm notification threshold flags",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "temperature": { "type": "boolean" },
        "vibration": { "type": "boolean" },
        "pressure": { "type": "boolean" },
        "critical": { "type": "boolean" }
      },
      "required": ["id", "workspaceId", "userId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time industrial alert dispatched to user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "severity": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "workspaceId", "title", "message"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of user engineering actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "date": { "type": "string" },
        "relatedObjectType": { "type": "string" },
        "relatedObjectId": { "type": "string" }
      },
      "required": ["id", "workspaceId", "action", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Enterprise user accounts" },
    "/workspaces/{workspaceId}": { "schema": "Workspace", "description": "Tenant facilities partition" },
    "/plants/{plantId}": { "schema": "Plant", "description": "Industrial production facilities" },
    "/productionLines/{lineId}": { "schema": "ProductionLine", "description": "Production trains" },
    "/machines/{machineId}": { "schema": "Machine", "description": "150+ rotating equipment fleet" },
    "/sensors/{sensorId}": { "schema": "Sensor", "description": "SCADA sensor channels" },
    "/telemetry/{telemetryId}": { "schema": "Telemetry", "description": "Hourly telemetry points" },
    "/thresholds/{thresholdId}": { "schema": "Threshold", "description": "Operating envelopes" },
    "/machineHealth/{healthId}": { "schema": "MachineHealth", "description": "Health scores" },
    "/machineRisk/{riskId}": { "schema": "MachineRisk", "description": "Risk matrix scores" },
    "/anomalies/{anomalyId}": { "schema": "Anomaly", "description": "Detected anomalies" },
    "/incidents/{incidentId}": { "schema": "Incident", "description": "Operational incidents" },
    "/maintenance/{maintenanceId}": { "schema": "Maintenance", "description": "Work orders" },
    "/investigations/{investigationId}": { "schema": "Investigation", "description": "RCA investigation dossiers" },
    "/investigationNotes/{noteId}": { "schema": "InvestigationNote", "description": "RCA collaboration notes" },
    "/recommendations/{recommendationId}": { "schema": "Recommendation", "description": "NOVA prescriptive actions" },
    "/reports/{reportId}": { "schema": "Report", "description": "Asset integrity dossiers" },
    "/reportVersions/{versionId}": { "schema": "ReportVersion", "description": "Report revision versions" },
    "/novaConversations/{conversationId}": { "schema": "NovaConversation", "description": "NOVA consultation threads" },
    "/novaMessages/{messageId}": { "schema": "NovaMessage", "description": "NOVA assistant dialogue" },
    "/savedViews/{viewId}": { "schema": "SavedView", "description": "User saved filtered views" },
    "/dashboardConfigurations/{configId}": { "schema": "DashboardConfig", "description": "User dashboard configurations" },
    "/alertPreferences/{prefId}": { "schema": "AlertPreference", "description": "Alert notification settings" },
    "/notifications/{notificationId}": { "schema": "Notification", "description": "User notifications" },
    "/activityLogs/{logId}": { "schema": "ActivityLog", "description": "User audit activity logs" }
  }
}

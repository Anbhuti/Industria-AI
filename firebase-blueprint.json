{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile and enterprise authorization role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "title": { "type": "string" },
        "clearance": { "type": "string" },
        "badgeId": { "type": "string" },
        "avatar": { "type": "string" },
        "workspaceId": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "workspaceId"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Tenant partition isolating industrial plants and machinery data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "industry": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDemo": { "type": "boolean" }
      },
      "required": ["id", "userId", "name"]
    },
    "Plant": {
      "title": "Plant",
      "description": "Industrial production facility entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "country": { "type": "string" },
        "industry": { "type": "string" },
        "operationalStatus": { "type": "string" },
        "unitsCount": { "type": "number" },
        "activeLoadMW": { "type": "number" },
        "targetLoadMW": { "type": "number" },
        "overallOEE": { "type": "number" },
        "status": { "type": "string" },
        "telemetryStreamStatus": { "type": "string" },
        "ambientTempC": { "type": "number" },
        "lastSyncTimestamp": { "type": "string" }
      },
      "required": ["id", "workspaceId", "name", "status"]
    },
    "ProductionLine": {
      "title": "ProductionLine",
      "description": "Continuous or discrete production train inside an industrial facility",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "plantId": { "type": "string" },
        "name": { "type": "string" },
        "lineCode": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "throughputUnitsPerHour": { "type": "number" },
        "targetThroughput": { "type": "number" },
        "activeMachinesCount": { "type": "number" }
      },
      "required": ["id", "workspaceId", "plantId", "name"]
    },
    "Machine": {
      "title": "Machine",
      "description": "Rotating industrial machinery asset with live telemetry and diagnostics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "plantId": { "type": "string" },
        "productionLineId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "tag": { "type": "string" },
        "productionLine": { "type": "string" },
        "plantArea": { "type": "string" },
        "location": { "type": "string" },
        "manufacturer": { "type": "string" },
        "risk": { "type": "string" },
        "criticality": { "type": "string" },
        "healthScore": { "type": "number" },
        "status": { "type": "string" },
        "operatingLoadPct": { "type": "number" },
        "energyKW": { "type": "number" },
        "alarm": { "type": "string" },
        "novaInsight": { "type": "string" },
        "rulDays": { "type": "number" },
        "mtbfHours": { "type": "number" }
      },
      "required": ["id", "workspaceId", "plantId", "name", "tag", "status", "healthScore"]
    },
    "Sensor": {
      "title": "Sensor",
      "description": "SCADA sensor monitoring vibration, temperature, pressure, or harmonics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "machineId": { "type": "string" },
        "plantId": { "type": "string" },
        "channelName": { "type": "string" },
        "scadaTag": { "type": "string" },
        "measurementType": { "type": "string" },
        "unit": { "type": "string" },
        "currentValue": { "type": "number" },
        "warningLimit": { "type": "number" },
        "criticalLimit": { "type": "number" },
        "samplingRateHz": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "workspaceId", "machineId", "scadaTag", "measurementType"]
    },
    "Telemetry": {
      "title": "Telemetry",
      "description": "Historical time-series telemetry data point",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "machineId": { "type": "string" },
        "timestamp": { "type": "string" },
        "vibrationRMS": { "type": "number" },
        "bearingTemp": { "type": "number" },
        "suctionPressure": { "type": "number" },
        "dischargePressure": { "type": "number" },
        "rotorRPM": { "type": "number" },
        "lubeOilNAS": { "type": "number" },
        "acousticDB": { "type": "number" },
        "motorCurrent": { "type": "number" },
        "energyKW": { "type": "number" },
        "operatingLoadPct": { "type": "number" }
      },
      "required": ["id", "workspaceId", "machineId", "timestamp"]
    },
    "Threshold": {
      "title": "Threshold",
      "description": "Configured vibration, temperature, and pressure operating envelopes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "machineId": { "type": "string" },
        "tempWarning": { "type": "number" },
        "tempCritical": { "type": "number" },
        "vibWarning": { "type": "number" },
        "vibCritical": { "type": "number" },
        "pressWarning": { "type": "number" },
        "pressCritical": { "type": "number" },
        "rpmLimit": { "type": "number" },
        "energyThreshold": { "type": "number" }
      },
      "required": ["id", "workspaceId", "machineId"]
    },
    "MachineHealth": {
      "title": "MachineHealth",
      "description": "Multi-dimensional asset reliability and degradation scoring",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "machineId": { "type": "string" },
        "overallScore": { "type": "number" },
        "mechanicalHealth": { "type": "number" },
        "electricalHealth": { "type": "number" },
        "thermalHealth": { "type": "number" },
        "lubricationHealth": { "type": "number" },
        "rulDays": { "type": "number" },
        "calculatedAt": { "type": "string" }
      },
      "required": ["id", "workspaceId", "machineId", "overallScore"]
    },
    "MachineRisk": {
      "title": "MachineRisk",
      "description": "Asset failure probability and financial business consequence rating",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "machineId": { "type": "string" },
        "riskCategory": { "type": "string" },
        "failureProbabilityPct": { "type": "number" },
        "consequenceRating": { "type": "number" },
        "financialExposurePerHourUSD": { "type": "number" },
        "primaryRiskDriver": { "type": "string" },
        "evaluatedAt": { "type": "string" }
      },
      "required": ["id", "workspaceId", "machineId", "riskCategory"]
    },
    "Anomaly": {
      "title": "Anomaly",
      "description": "Detected multi-signal SCADA anomaly event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "machineId": { "type": "string" },
        "plantId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "detectedMetric": { "type": "string" },
        "observedValue": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "workspaceId", "machineId", "title", "severity"]
    },
    "Incident": {
      "title": "Incident",
      "description": "Asset trip or excursion incident record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "machineId": { "type": "string" },
        "plantId": { "type": "string" },
        "incidentNumber": { "type": "string" },
        "title": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "summary": { "type": "string" },
        "reportedBy": { "type": "string" },
        "assignedEngineer": { "type": "string" },
        "openedAt": { "type": "string" },
        "resolvedAt": { "type": "string" }
      },
      "required": ["id", "workspaceId", "machineId", "incidentNumber", "title", "severity"]
    },
    "Maintenance": {
      "title": "Maintenance",
      "description": "Preventative and corrective maintenance work order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "machineId": { "type": "string" },
        "workOrderNumber": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "dueDate": { "type": "string" },
        "technician": { "type": "string" },
        "description": { "type": "string" },
        "estimatedHours": { "type": "number" }
      },
      "required": ["id", "workspaceId", "machineId", "workOrderNumber", "type", "status"]
    },
    "Investigation": {
      "title": "Investigation",
      "description": "Root-cause failure analysis (RCA) dossier with 5-Whys and CAPA",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "incidentId": { "type": "string" },
        "plantId": { "type": "string" },
        "title": { "type": "string" },
        "assetId": { "type": "string" },
        "assetName": { "type": "string" },
        "tag": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "currentStep": { "type": "number" },
        "timestamp": { "type": "string" },
        "summary": { "type": "string" },
        "confidence": { "type": "number" }
      },
      "required": ["id", "workspaceId", "assetId", "title", "status"]
    },
    "InvestigationNote": {
      "title": "InvestigationNote",
      "description": "Collaborative investigator notes attached to an RCA session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "investigationId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "note": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "investigationId", "note"]
    },
    "Recommendation": {
      "title": "Recommendation",
      "description": "Prescriptive engineering action proposed by NOVA diagnostics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "machineId": { "type": "string" },
        "title": { "type": "string" },
        "action": { "type": "string" },
        "urgency": { "type": "string" },
        "expectedImpact": { "type": "string" },
        "confidencePct": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "workspaceId", "machineId", "title", "status"]
    },
    "Report": {
      "title": "Report",
      "description": "Asset integrity dossier and regulatory compliance report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "reportNumber": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "typeLabel": { "type": "string" },
        "plantId": { "type": "string" },
        "machineId": { "type": "string" },
        "createdDate": { "type": "string" },
        "version": { "type": "number" },
        "status": { "type": "string" },
        "generatedBy": { "type": "string" },
        "summary": { "type": "string" }
      },
      "required": ["id", "workspaceId", "reportNumber", "name", "status"]
    },
    "ReportVersion": {
      "title": "ReportVersion",
      "description": "Versioned revision snapshot of an engineering dossier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reportId": { "type": "string" },
        "versionNumber": { "type": "number" },
        "date": { "type": "string" },
        "author": { "type": "string" },
        "summary": { "type": "string" }
      },
      "required": ["id", "reportId", "versionNumber"]
    },
    "NovaConversation": {
      "title": "NovaConversation",
      "description": "NOVA industrial copilot conversation thread",
